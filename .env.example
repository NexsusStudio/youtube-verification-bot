# Copy these values into KATABUMP Environment Variables / Secrets.
# Never commit a real .env file or bot token to GitHub.
DISCORD_TOKEN=PUT_BOT_TOKEN_IN_KATABUMP_ONLY
CLIENT_ID=YOUR_DISCORD_APPLICATION_ID
GUILD_ID=YOUR_DISCORD_SERVER_ID

# Optional: comma-separated trusted Admin/Owner role IDs.
# If empty, the bot checks roles named exactly "Admin" or "Owner",
# plus the Discord server owner.
ADMIN_ROLE_IDS=

# Optional: channel/category names used by /setup-verification
VERIFY_CATEGORY_NAME=VERIFICATION
VERIFY_SUBMIT_CHANNEL_NAME=verification-submit
VERIFY_ADMIN_CHANNEL_NAME=verification-admin
SUBSCRIBER_ROLE_NAME=SUBSCRIBER
